+
+    // The derivations above all need a 12-character serial. EPOC and EPOC+
+    // hardware keys from the last FOUR characters instead, so those schemes
+    // are added here - without them an 8-character serial yields no candidate
+    // at all and the stream decrypts to noise.
+    for serial in serials {
+        for (name, derive) in crate::raw::decryption::emokit_keys::ALL {
+            let Some(key) = derive(serial) else { continue };
+            for &m in &models {
+                if let Ok(decryptor) = Decryptor::with_key(m, key.clone()) {
+                    out.push(KeyCandidate {
+                        serial: format!("{serial}/{name}"),
+                        model: m,
+                        decryptor,
+                    });
+                }
+            }
+        }
+    }
     out
 }
 
