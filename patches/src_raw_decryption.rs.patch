+    /// Create a decryptor from an already-derived 16-byte key.
+    ///
+    /// The derivations in this module all require a 12-character serial, but
+    /// the EPOC and EPOC+ hardware uses schemes that need only the last FOUR
+    /// characters (see [`emokit_keys`]). Those cannot go through
+    /// [`Self::new`], so they are built here instead.
+    pub fn with_key(model: HeadsetModel, aes_key: Vec<u8>) -> Result<Self> {
+        if aes_key.len() != 16 {
+            return Err(anyhow!("AES key must be 16 bytes, got {}", aes_key.len()));
+        }
+        let (physical_min, physical_max) = model.eeg_physical_range();
+        let digital_max = match model {
+            HeadsetModel::Xtrodes => 65535i32,
+            _ => 16383i32,
+        };
+        Ok(Self {
+            model,
+            // The keys built this way come from the EPOC/EPOC+ hardware
+            // schemes, and that hardware uses the byte-pair layout.
+            format: PacketFormat::EpocPlusPairs,
+            aes_key,
+            counter: 0,
+            physical_min,
+            physical_max,
+            digital_max,
+        })
+    }
+
+    /// Decode an EPOC/EPOC+ receiver packet, whose plaintext is a one-byte
+    /// counter followed by one big-endian-ish BYTE PAIR per electrode.
+    ///
+    /// Seven electrodes occupy bytes 2..16 and seven more bytes 18..32; bytes
+    /// 16 and 17 are skipped. The microvolt conversion is the one the EPOC+
+    /// firmware uses, reproduced from CyKit.
+    ///
+    /// Packets whose second byte is 32 carry no motion payload and are
+    /// rejected, matching CyKit, which drops them rather than decoding.
+    fn decode_epoc_plus_pairs(&mut self, decrypted: &[u8]) -> Result<DecryptedData> {
+        if decrypted.len() < 32 {
+            return Err(anyhow!(
+                "EPOC+ packet must be 32 bytes, got {}",
+                decrypted.len()
+            ));
+        }
+        if decrypted[1] == 32 {
+            return Err(anyhow!("EPOC+ packet carries no sample payload"));
+        }
+
+        let counter = decrypted[0];
+        self.counter = counter as u32;
+
+        let mut eeg_uv = Vec::with_capacity(14);
+        let mut eeg_adc = Vec::with_capacity(14);
+        for range in [(2usize..16usize), (18usize..32usize)] {
+            for i in range.step_by(2) {
+                let (a, b) = (decrypted[i], decrypted[i + 1]);
+                eeg_uv.push(epoc_plus_microvolts(a, b));
+                eeg_adc.push(u16::from_be_bytes([a, b]) as i32);
+            }
+        }
+
+        // Contact quality and battery live elsewhere in this format and are
+        // not yet decoded. Reporting zeros is deliberate: inventing values
+        // from the wrong offsets is what made the earlier output look
+        // plausible while being meaningless.
+        let contact_quality = vec![0u8; eeg_uv.len()];
+        let signal_quality = 0u8;
+        let battery_percent = 0u8;
+
+        Ok(DecryptedData::new(
+            counter as u32,
+            eeg_uv,
+            eeg_adc,
+            contact_quality,
+            signal_quality,
+            battery_percent,
+        ))
+    }
