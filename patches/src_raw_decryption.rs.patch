+/// Key derivations used by the open-source EPOC drivers.
+///
+/// These build the 16-byte AES key from the LAST FOUR characters of the
+/// serial, unlike the derivations above which index twelve. They are what the
+/// EPOC and EPOC+ hardware actually uses, mirrored from `openyou/emokit`
+/// (`python/emokit/util.py`) and `CymatiCorp/CyKit`
+/// (`Examples/example_epoc_plus.py`), which agree with each other.
+///
+/// Note the serial that matters is the one the USB receiver reports, not the
+/// one printed on the headset: on this hardware the receiver's serial is what
+/// keys the stream.
+pub mod emokit_keys {
+    /// The derivation CyKit uses for the EPOC+ (`new_crypto_key` in emokit).
+    pub fn new_crypto(serial: &str) -> Option<Vec<u8>> {
+        let s: Vec<char> = serial.chars().collect();
+        let n = s.len();
+        if n < 4 {
+            return None;
+        }
+        let (a, b, c, d) = (s[n - 1], s[n - 2], s[n - 3], s[n - 4]);
+        let k = [a, b, b, c, c, c, b, d, a, d, b, b, d, d, b, a];
+        Some(k.iter().map(|&ch| ch as u8).collect())
+    }
+
+    /// emokit's `epoc_plus_crypto_key`, which interleaves fixed bytes.
+    pub fn epoc_plus(serial: &str) -> Option<Vec<u8>> {
+        let s: Vec<char> = serial.chars().collect();
+        let n = s.len();
+        if n < 4 {
+            return None;
+        }
+        let (a, b, c, d) = (s[n - 1] as u8, s[n - 2] as u8, s[n - 3] as u8, s[n - 4] as u8);
+        Some(vec![a, 0x00, b, 0x15, c, 0x00, d, 0x0C, c, 0x00, b, b'D', a, 0x00, b, b'X'])
+    }
+
+    /// emokit's `crypto_key` with `is_research = false`.
+    pub fn consumer(serial: &str) -> Option<Vec<u8>> {
+        let s: Vec<char> = serial.chars().collect();
+        let n = s.len();
+        if n < 4 {
+            return None;
+        }
+        let (a, b, c, d) = (s[n - 1] as u8, s[n - 2] as u8, s[n - 3] as u8, s[n - 4] as u8);
+        Some(vec![a, 0x00, b, b'T', c, 0x10, d, b'B', a, 0x00, b, b'H', c, 0x00, d, b'P'])
+    }
+
+    /// emokit's `crypto_key` with `is_research = true`.
+    pub fn research(serial: &str) -> Option<Vec<u8>> {
+        let s: Vec<char> = serial.chars().collect();
+        let n = s.len();
+        if n < 4 {
+            return None;
+        }
+        let (a, b, c, d) = (s[n - 1] as u8, s[n - 2] as u8, s[n - 3] as u8, s[n - 4] as u8);
+        Some(vec![a, 0x00, b, b'H', a, 0x00, b, b'T', c, 0x10, d, b'B', c, 0x00, d, b'P'])
+    }
+
+    /// Every derivation, in the order worth trying.
+    pub const ALL: [(&str, fn(&str) -> Option<Vec<u8>>); 4] = [
+        ("new_crypto", new_crypto),
+        ("epoc_plus", epoc_plus),
+        ("consumer", consumer),
+        ("research", research),
+    ];
+}
