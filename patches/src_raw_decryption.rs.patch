+/// The EPOC+ byte-pair to microvolt conversion used by the firmware.
+///
+/// Reproduced from CymatiCorp/CyKit `example_epoc_plus.py`
+/// (`convertEPOC_PLUS`). Verified on live hardware: with the headset off the
+/// head every channel sits near 4249 with a 2-11 uV spread, against the
+/// ~4800 uV uniform noise a wrong key or layout produces.
+fn epoc_plus_microvolts(value_1: u8, value_2: u8) -> f64 {
+    (f64::from(value_1) * 0.128_205_128_205_129) + 4201.025_640_960_01
+        + ((f64::from(value_2) - 128.0) * 32.820_512_89)
+}
