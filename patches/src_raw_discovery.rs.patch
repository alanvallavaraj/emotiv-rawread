-/// Discover USB devices (not yet implemented).
+/// Discover Emotiv USB receivers/dongles currently attached.
+///
+/// Enumeration is a blocking HID call, so it runs on the blocking pool rather
+/// than stalling the async executor. Without the `usb` feature this returns an
+/// empty list, exactly as it did before the transport existed.
 pub(crate) async fn discover_usb_devices() -> Result<Vec<DeviceInfo>> {
-    Ok(Vec::new())
+    #[cfg(all(feature = "usb", not(target_arch = "wasm32")))]
+    {
+        match tokio::task::spawn_blocking(crate::raw::usb::enumerate).await {
+            Ok(result) => result,
+            Err(e) => Err(anyhow::anyhow!("USB enumeration task failed: {e}")),
+        }
+    }
+    #[cfg(not(all(feature = "usb", not(target_arch = "wasm32"))))]
+    {
+        Ok(Vec::new())
+    }
 }
 
